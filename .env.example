# Upbit Open API Keys (Required for Live Trading, optional when DRY_RUN=True)
UPBIT_ACCESS_KEY=your_upbit_access_key_here
UPBIT_SECRET_KEY=your_upbit_secret_key_here

# Trading Mode: True for Simulation (Safe Paper Trading), False for Live Trading
DRY_RUN=True

# ========================================================
# Live Order 5-Layer Hard Guardrail Settings
# - LIVE_EXECUTOR_OWNER: 단일 실전 주문 실행 주체 ('node' | 'python', 기본값: 'node')
# - 일치하지 않는 프로세스는 실전 주문 API(POST /v1/orders) 진입 즉시 하드 차단
# ========================================================
LIVE_EXECUTOR_OWNER=node
LIVE_LEASE_TTL_SEC=30
LIVE_REENTRY_COOLDOWN_SEC=900
LIVE_MIN_BUY_INTERVAL_SEC=60
LIVE_MAX_BUYS_PER_BOT_HOUR=3
LIVE_MAX_BUYS_PER_BOT_DAY=12
LIVE_MAX_TOTAL_BUYS_DAY=30
LIVE_ANOMALY_BLOCK_THRESHOLD=5
LIVE_ANOMALY_WINDOW_SEC=300
LIVE_ANOMALY_TIMEOUT_THRESHOLD=2

# LLM API Keys (At least one required for live AI analysis, otherwise automatic fallback runs)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ========================================================
# Multi-Channel Notification Hub (Telegram · Discord)
# - Git 저장소에는 예제 값만 포함됩니다.
# - 실제 토큰과 Chat ID는 로컬 .env(Git 제외) 또는 웹 대시보드 설정(SQLite AES-256-GCM 암호화 저장)에만 보관하십시오.
# ========================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# ========================================================
# Local Ollama (30m FLASH_30M Coin News & Market Analysis)
# - 1st-tier engine for 30m short-term crypto news & regime analysis
# - Automatically falls back to Gemini Flash -> BTC 20MA mechanical mode on failure/timeout
# ========================================================
USE_LOCAL_OLLAMA_NEWS=true
OLLAMA_BASE_URL=http://192.168.0.100:11434
OLLAMA_NEWS_MODEL=qwen3-news
OLLAMA_TIMEOUT_MS=120000

# SQLite Database Path (Default: data/auto_coin_trade.db)
DB_PATH=data/auto_coin_trade.db

# Initial Total Capital for Simulation in KRW (Default: 1,000,000 KRW)
INITIAL_TOTAL_CAPITAL=1000000

# LLM Filter Worker Interval in seconds (Default: 3600 = 1 hour)
LLM_FILTER_INTERVAL_SEC=3600

# Daily Log Retention Days (Default: 7 days, rotated at 00:00 KST as *.log_yyyymmdd)
LOG_RETENTION_DAYS=7

# ========================================================
# Web Dashboard Security Gate Code (Default: stock)
# - 기본 입장 코드: stock (한글 자판 오타 'ㄴ새차' 자동 변환 지원)
# - 사용자가 원하는 코드로 자유롭게 변경 가능
# ========================================================
GATE_CODE=stock
ENTRY_CODE=stock

# ========================================================
# Network & Server Port Settings
# ========================================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
# 로컬 루프백 기본값 127.0.0.1 (외부 접속은 start_tunnel.sh 보안 터널 권장, LAN 공유 시에만 0.0.0.0 사용)
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=9000
BACKEND_URL=http://127.0.0.1:8001

# ========================================================
# Database Connection Location Mode: 'local' 또는 'outer'
# - local : 로컬 PC 내부 접속 (기본 127.0.0.1:5432)
# - outer : 외부 인터넷 원격 접속 (your_remote_server_ip:5432 등)
# ========================================================
LOCATION=local

# --------------------------------------------------------
# [Local] 로컬 PC 내부 DB 접속 정보
# --------------------------------------------------------
LOCAL_PG_HOST=127.0.0.1
LOCAL_PG_PORT=5432
LOCAL_PG_DATABASE=coin_trader
LOCAL_PG_USER=coin_trader
LOCAL_PG_PASSWORD=your_pg_password_here

# --------------------------------------------------------
# [Outer] 외부 인터넷 원격 DB 접속 정보 (공인 IP 또는 외부 도메인)
# --------------------------------------------------------
OUTER_PG_HOST=your_remote_server_ip
OUTER_PG_PORT=5432
OUTER_PG_DATABASE=coin_trader
OUTER_PG_USER=coin_trader
OUTER_PG_PASSWORD=your_pg_password_here

# Fallback 호환용
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=coin_trader
PGUSER=coin_trader
PGPASSWORD=your_pg_password_here
DATABASE_URL=postgresql://coin_trader:your_pg_password_here@127.0.0.1:5432/coin_trader
