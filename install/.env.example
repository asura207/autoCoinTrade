# ============================================================================
# AutoCoinTrade Docker 환경 설정 (.env.example -> .env)
# ============================================================================

# 1. 거래 모드 및 초기 자본금
# DRY_RUN=True (안전 모의투자 기본값) / False (실전 거래)
DRY_RUN=True
INITIAL_TOTAL_CAPITAL=1000000
LIVE_EXECUTOR_OWNER=node

# 2. 웹 대시보드 입장 코드 (기본: stock)
GATE_CODE=stock
ENTRY_CODE=stock

# 3. 포트 설정 (호스트 외부 노출 포트)
FRONTEND_PORT=9000
BACKEND_PORT=8001
PGPORT=5432

# 4. 내장 PostgreSQL 16 + SQLite WAL 하이브리드 DB 설정
# - postgres_hybrid : 내장 PostgreSQL 16 컨테이너 + 로컬 SQLite WAL 동시 운용 (기본값)
# - sqlite          : SQLite WAL 단독 운용 (PG_SYNC_ENABLED=false 함께 설정)
DB_MODE=postgres_hybrid
PG_SYNC_ENABLED=true
PGDATABASE=coin_trader
PGUSER=coin_trader
PGPASSWORD=autocoin_pg_pass

# 5. 업비트 & AI API 키 (웹 대시보드 초기 설정 마법사에서도 암호화 입력 가능)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# 6. 로컬 Ollama 30분 단기 뉴스 분석 (호스트 PC에서 Ollama 실행 시)
USE_LOCAL_OLLAMA_NEWS=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_NEWS_MODEL=qwen3-news
OLLAMA_TIMEOUT_MS=180000
LLM_FILTER_INTERVAL_SEC=3600

# 7. 멀티채널 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# 8. 로그 보관 일수
LOG_RETENTION_DAYS=7
